# ─── Public (exposed to browser) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://sumurbor.rofimain.com
NEXT_PUBLIC_WEB3FORMS_KEY=
# Opsional fallback GA4 jika belum diisi lewat /admin/seo
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Server-side only (DO NOT expose) ───────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login credentials (single admin)
ADMIN_EMAIL=admin@rofimain.com
ADMIN_PASSWORD=change-this-strong-password

# JWT signing secret (run `openssl rand -base64 32` to generate)
JWT_SECRET=change-this-to-a-random-32-byte-base64-string
